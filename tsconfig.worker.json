{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["@cloudflare/vitest-plugin/types"]
  },
  "include": ["src/worker", "src/db", "src/shared", "worker-configuration.d.ts"],
  "exclude": ["src/db/**/*.test.ts", "src/shared/**/*.test.ts"]
}
